# ---- core ----
ENV=production
DATABASE_URL=postgres://user:pass@host:5432/dbname
JWT_SECRET=change-me-long-random

# Required in production: explicit CORS allow-list. A wildcard is ignored when
# ENV=production because cookies are sent with credentials.
ALLOWED_ORIGINS=https://yiz-ai.onrender.com
# Public origin of this service; Render sets RENDER_EXTERNAL_URL for you.
PUBLIC_BASE_URL=
FRONTEND_URL=

# ---- LLM providers (set the ones you use; keys go here, never in code) ----
KIMI_API_KEY=sk-BE9QbHHCzZOV1DkJSXRMuCryxZf5ZyNZrF5xTwoG1hOEEav5 
DEEPSEEK_API_KEY=sk-b7caed30b749492b9f6827069552c43e 
OLLAMA_API_KEY=aa4e0653fdcb4346bcd77812b7d0938f.w9CAkRNRvXTH_a4YdWk9NMYL

# Kimi (Moonshot AI) and DeepSeek both speak the OpenAI chat-completions format.
# Defaults point at their hosted APIs; only change these for a self-hosted proxy.
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama Cloud (default when OLLAMA_API_KEY is set) or your own host:
#   OLLAMA_BASE_URL=https://ollama.com/v1
#   OLLAMA_BASE_URL=http://my-ollama-host:11434/v1
OLLAMA_BASE_URL=

# Default model per provider (users can still pick any other from /api/models)
KIMI_MODEL=kimi-k2-0711-preview
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=llama3.1

# Which provider serves a request when the caller does not name a model.
# Empty = auto: anthropic, then openai, then kimi, then deepseek, then ollama.
LLM_PROVIDER=

# Let callers override the model per request ("openai:gpt-4o"). Set false to lock it down
# entirely for a public production service.
# Callers may only pick a specific model/provider when this is true.
# Off by default: leaving it off means every request uses the server's
# configured default provider/model, which is the safer choice for a
# public deployment (predictable cost, no per-request provider steering).
ALLOW_MODEL_OVERRIDE=false
# When an override is used, require the model to exist in that provider's live
# /api/models listing (protects against arbitrary/typo'd model names and their
# cost). Fails open if the listing call itself fails.
MODEL_OVERRIDE_STRICT=true
MODEL_LIST_TTL=300
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_VERSION=2023-06-01
# Only change these for a proxy / gateway:
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Audio transcription (voice notes) via OpenAI's /audio/transcriptions API.
# Reuses OPENAI_API_KEY/OPENAI_BASE_URL above; no effect without an OpenAI key.
TRANSCRIBE_MODEL=whisper-1

# ---- MCP ----
MCP_SERVERS=name=https://mcp.example.com
MCP_ALLOW_PRIVATE=false      # true only for local dev against localhost servers
MCP_MAX_RESPONSE_BYTES=2000000
MCP_TIMEOUT=30

# ---- optional ----
REDIS_URL=
TAVILY_API_KEY=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
SANDBOX_PROVIDER=piston
