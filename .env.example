# ============================================================
# Yiz AI — environment. Copy to .env and fill in.
# Blank values are secrets you supply. Shown values are defaults.
# ============================================================

# ---------- Database (REQUIRED — the app refuses to boot without it) ----------
# asyncpg DSN. postgres:// is accepted and normalized to postgresql://
DATABASE_URL=

# ---------- Auth ----------
# REQUIRED when ENV=production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Access-token lifetime in minutes.
ACCESS_TTL_MIN=15
# Refresh-token and session lifetime in days.
REFRESH_TTL_DAYS=30

# ---------- Cache / rate limit (optional) ----------
# Without REDIS_URL, rate limiting falls back to per-process memory.
REDIS_URL=
RL_LOGIN_PER_MIN=8
RL_SIGNUP_PER_MIN=4
RL_API_PER_MIN=120

# ---------- LLM ----------
# Auto priority when LLM_PROVIDER is unset: anthropic, then openai, then ollama.
# Set LLM_PROVIDER to force one explicitly: anthropic | openai | ollama
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Cloud: set OLLAMA_API_KEY only; OLLAMA_BASE_URL defaults to
# https://ollama.com/v1 automatically. Self-hosted Ollama: set OLLAMA_BASE_URL
# to your server's OpenAI-compatible endpoint (e.g. http://ollama:11434/v1)
# and leave OLLAMA_API_KEY blank unless your server requires a bearer token.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Enables the web_search tool. Without it, web_search returns a config error.
TAVILY_API_KEY=

# ---------- Code sandbox ----------
# piston | e2b | off
SANDBOX_PROVIDER=piston
PISTON_URL=https://emkc.org/api/v2/piston
E2B_API_KEY=
SANDBOX_TIMEOUT=30
SANDBOX_RUNS_PER_MIN=10

# ---------- Automation ----------
N8N_WEBHOOK_URL=
N8N_API_KEY=
# Comma-separated name=url pairs, e.g. github=https://mcp.example.com
MCP_SERVERS=
PLUGINS_DIR=plugins

# ---------- Media ----------
# Must be writable and should be a persistent volume in production.
MEDIA_DIR=media
# 25 MiB. Enforced on every upload and every generated file.
MEDIA_MAX_BYTES=26214400
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# ---------- OAuth (optional; needs OAUTH_REDIRECT_BASE to activate) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin of this app, no trailing slash, e.g. https://yiz.example.com
OAUTH_REDIRECT_BASE=
# Where to land after OAuth when no safe next path was supplied.
FRONTEND_URL=

# ---------- App ----------
# production | development
ENV=production
PORT=8000
# true when the frontend is served from a different origin (SameSite=None; Secure).
CROSS_ORIGIN=false
# Comma-separated origins, or * to echo any origin.
ALLOWED_ORIGINS=
ALLOW_REGISTRATION=true
# Maximum tool-calling rounds per turn.
MAX_STEPS=6
# Maximum prior messages replayed to the model per turn.
MAX_CONTEXT_MESSAGES=60
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DB_CONNECT_RETRIES=8
DB_CONNECT_TIMEOUT_SEC=10

# Storage: local for development; s3 for Cloudflare R2, AWS S3, MinIO, Backblaze B2, etc.
MEDIA_STORAGE=local
MEDIA_DIR=media
MEDIA_CACHE_DIR=media/cache
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=yiz-ai

# Redis worker queue
YIZ_JOB_QUEUE=yiz:jobs
YIZ_JOB_TTL=3600
YIZ_JOB_WAIT_TIMEOUT=900

# Standalone frontend
FRONTEND_URL=

# Production R2 profile: see storage/r2/production.env.example
# Never commit real S3/R2 credentials.
